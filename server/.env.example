# Server Environment Variables (Placeholders)
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (adjust USERNAME, PASSWORD, HOST, PORT, and DATABASE_NAME)
# For local PostgreSQL: postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public
# For Cloud PostgreSQL (Render / Supabase / Neon): postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# JWT Secret & Expiration
JWT_SECRET="YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS"
JWT_EXPIRES_IN="7d"

# Allowed Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Node-Cron Recurring Transactions Schedule (Daily at midnight: "0 0 * * *")
CRON_SCHEDULE="0 0 * * *"
